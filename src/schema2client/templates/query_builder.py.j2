class {{ table.prefix }}QueryBuilder:
    _table_name: ClassVar[str] = "{{ table.table_name }}"

    def __init__(self) -> None:
        self._filters: list[tuple[str, str, str]] = []
        self._select: _Select = _Select(("*",))
        self._mutation: tuple[str, dict[str, object]] | None = None
        self._on_conflict = ""
        self._order: list[tuple[str, bool]] = []
        self._limit: int | None = None
        self._offset: int | None = None
        self._range: tuple[int, int] | None = None
        self._single = False
        self._sync_transport: _SyncHttpTransport | None = None
        self._async_transport: _AsyncHttpTransport | None = None

    @staticmethod
    def _encode(value: object) -> str:
        if isinstance(value, bool):
            return "true" if value else "false"
        return str(value)

{{ filter_methods(table, table.prefix ~ "QueryBuilder", "self") }}
    def insert(self, row: {{ table.insert_class }}) -> {{ table.prefix }}Query[{{ table.row_class }}]:
        self._mutation = ("insert", _model_payload(row))
        self._select = _Select(("*",))
        return {{ table.prefix }}Query(self, _{{ table.table_name }}_star)

    def upsert(
        self,
        row: {{ table.insert_class }},
        *,
        on_conflict: str = "",
    ) -> {{ table.prefix }}Query[{{ table.row_class }}]:
        self._on_conflict = on_conflict
        self._mutation = ("upsert", _model_payload(row))
        self._select = _Select(("*",))
        return {{ table.prefix }}Query(self, _{{ table.table_name }}_star)

    def update(self, row: {{ table.update_class }}) -> {{ table.prefix }}Query[{{ table.row_class }}]:
        self._mutation = ("update", _model_payload(row))
        self._select = _Select(("*",))
        return {{ table.prefix }}Query(self, _{{ table.table_name }}_star)

    def delete(self) -> {{ table.prefix }}Query[{{ table.row_class }}]:
        self._mutation = ("delete", {})
        self._select = _Select(("*",))
        return {{ table.prefix }}Query(self, _{{ table.table_name }}_star)

    @overload
    def select(self, column: Literal["*"], /) -> {{ table.prefix }}Query[{{ table.row_class }}]: ...
{% for spec in table.select_overloads %}
    @overload
    def select(
        self,
        {% for name in spec.arg_names %}
        column_{{ loop.index }}: Literal["{{ name }}"],
        {% endfor %}
        /,
    ) -> {{ table.prefix }}Query[{{ spec.class_name }}]: ...
{% endfor %}
    def select(self, *columns: str) -> object:
        if columns == ("*",):
            self._select = _Select(("*",))
            return {{ table.prefix }}Query(self, _{{ table.table_name }}_star)
        if len(columns) < 1 or len(columns) > 3 or len(set(columns)) != len(columns):
            msg = "select() accepts '*' or 1 to 3 distinct columns"
            raise ValueError(msg)
        key = tuple(sorted(columns))
        adapter = _{{ table.table_name }}_adapters.get(key)
        if adapter is None:
            msg = f"unknown columns {columns!r}"
            raise ValueError(msg)
        self._select = _Select(tuple(columns))
        return {{ table.prefix }}Query(self, adapter)


class {{ table.prefix }}Query(Generic[_RowT]):
    def __init__(self, parent: {{ table.prefix }}QueryBuilder, adapter: object) -> None:
        self._parent = parent
        self._adapter = adapter

{{ filter_methods(table, table.prefix ~ "Query[_RowT]", "self._parent") }}
    def single(self) -> {{ table.prefix }}Single[_RowT]:
        self._parent._single = True
        return {{ table.prefix }}Single(self._parent, self._adapter)

    def execute(self) -> list[_RowT]:
        transport = self._parent._sync_transport
        if transport is None:
            empty: list[_RowT] = []
            return empty
        raw = transport.fetch({{ table.prefix }}QueryBuilder._table_name, self._parent)
        rows = raw if isinstance(raw, list) else [raw]
        parsed = cast(TypeAdapter[list[_RowT]], self._adapter).validate_python(rows)
        return parsed

    async def execute_async(self) -> list[_RowT]:
        transport = self._parent._async_transport
        if transport is None:
            empty: list[_RowT] = []
            return empty
        raw = await transport.fetch({{ table.prefix }}QueryBuilder._table_name, self._parent)
        rows = raw if isinstance(raw, list) else [raw]
        parsed = cast(TypeAdapter[list[_RowT]], self._adapter).validate_python(rows)
        return parsed


class {{ table.prefix }}Single(Generic[_RowT]):
    def __init__(self, parent: {{ table.prefix }}QueryBuilder, adapter: object) -> None:
        self._parent = parent
        self._adapter = adapter

    def execute(self) -> _RowT:
        transport = self._parent._sync_transport
        if transport is None:
            msg = "query is not bound to a client"
            raise RuntimeError(msg)
        raw = transport.fetch({{ table.prefix }}QueryBuilder._table_name, self._parent)
        parsed = cast(TypeAdapter[list[_RowT]], self._adapter).validate_python([raw])
        return parsed[0]

    async def execute_async(self) -> _RowT:
        transport = self._parent._async_transport
        if transport is None:
            msg = "query is not bound to a client"
            raise RuntimeError(msg)
        raw = await transport.fetch({{ table.prefix }}QueryBuilder._table_name, self._parent)
        parsed = cast(TypeAdapter[list[_RowT]], self._adapter).validate_python([raw])
        return parsed[0]



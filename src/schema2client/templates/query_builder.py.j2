class {{ table.prefix }}Query_star:
    def __init__(self, parent: {{ table.prefix }}QueryBuilder) -> None:
        self._parent = parent

    def execute(self) -> list[{{ table.row_class }}]:
        transport = self._parent._sync_transport
        if transport is None:
            return []
        raw = transport.fetch_rows({{ table.prefix }}QueryBuilder._table_name, self._parent)
        return _list_adapter_{{ table.table_name }}_star.validate_python(raw)

    async def execute_async(self) -> list[{{ table.row_class }}]:
        transport = self._parent._async_transport
        if transport is None:
            return []
        raw = await transport.fetch_rows({{ table.prefix }}QueryBuilder._table_name, self._parent)
        return _list_adapter_{{ table.table_name }}_star.validate_python(raw)



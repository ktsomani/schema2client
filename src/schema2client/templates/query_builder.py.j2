        value: list[{{ column.filter_type }}],
    ) -> {{ table.prefix }}QueryBuilder: ...
{% endfor %}
    def in_(self, column: str, value: object) -> {{ table.prefix }}QueryBuilder:
        if isinstance(value, list):
            encoded = ",".join(self._encode(item) for item in value)
        else:
            encoded = self._encode(value)
        self._filters.append((column, "in", encoded))
        return self

